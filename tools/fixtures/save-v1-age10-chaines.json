E TE PERMETTRAIT DE L’ÉCOUTER."},{"t":1272000,"txt":"SEUIL 9. L’HUILE NOIRE. LES ANCIENS EN ONT TROP UTILISÉ. TOI, UTILISE-LA BIEN."},{"t":1335000,"txt":"SEUIL 10. AVEC CES MATÉRIAUX, L’ESPACE T’EST OUVERT. CONSTRUIS UNE FUSÉE."}],"term":[],"notes":[],"stats":{"taps":1433,"crafts":19861,"tries":0,"play":1335},"cycle":1,"echoes":0,"meta":{"endings":{},"capsule":false},"settings":{"sound":true,"vibe":true},"pipAcc":0,"intuAcc":0.41666666666667107,"moon":0,"introSeen":true}